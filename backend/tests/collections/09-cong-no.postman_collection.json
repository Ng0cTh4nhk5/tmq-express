{
  "info": {
    "name": "09. Cong No",
    "description": "Quan ly cong no",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List CN",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/cong-no",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "cong-no"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Has summary\", () => pm.expect(pm.response.json().summary).to.be.an(\"object\"));",
              "const data = pm.response.json().data;",
              "if (data && data.length > 0) { const cn = data.find(c => c.trang_thai === \"chua_thu\"); if (cn) pm.environment.set(\"cong_no_id\", cn.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Filter CN Chua Thu",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/cong-no?trang_thai=chua_thu",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "cong-no"
          ],
          "query": [
            {
              "key": "trang_thai",
              "value": "chua_thu"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Xac Nhan Thanh Toan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/cong-no/{{cong_no_id}}/xac-nhan-thanh-toan",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "cong-no",
            "{{cong_no_id}}",
            "xac-nhan-thanh-toan"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hinh_thuc\": \"tien_mat\",\n  \"ghi_chu\": \"Test thanh toan Postman\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"PT created\", () => pm.expect(pm.response.json().data.phieu_thu).to.be.an(\"object\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "[FAIL] Xac Nhan Lai (Da Thu)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/cong-no/{{cong_no_id}}/xac-nhan-thanh-toan",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "cong-no",
            "{{cong_no_id}}",
            "xac-nhan-thanh-toan"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hinh_thuc\": \"tien_mat\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "[FAIL] Staff xac nhan cong no -> 403",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staff_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/cong-no/{{cong_no_id}}/xac-nhan-thanh-toan",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "cong-no",
            "{{cong_no_id}}",
            "xac-nhan-thanh-toan"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hinh_thuc\": \"tien_mat\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    }
  ]
}