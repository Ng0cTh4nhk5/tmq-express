      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Has base64\", () => pm.expect(pm.response.json().data.base64).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
