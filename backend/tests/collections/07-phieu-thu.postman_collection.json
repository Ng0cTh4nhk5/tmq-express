        ],
        "url": {
          "raw": "{{base_url}}/api/phieu-thu/{{phieu_thu_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "phieu-thu",
            "{{phieu_thu_id}}"
