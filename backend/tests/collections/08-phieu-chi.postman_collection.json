{
  "info": {
    "name": "08. Phieu Chi",
    "description": "Quan ly phieu chi",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List PC",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/phieu-chi",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "phieu-chi"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create PC",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/phieu-chi",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "phieu-chi"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nguoi_nhan\": \"Anh Minh\",\n  \"ly_do\": \"Chi phi test Postman\",\n  \"so_tien\": 100000\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.environment.set(\"phieu_chi_id\", pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Update PC",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/phieu-chi/{{phieu_chi_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "phieu-chi",
            "{{phieu_chi_id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nguoi_nhan\": \"Anh Minh Updated\",\n  \"so_tien\": 120000\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Cancel PC (Admin)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/phieu-chi/{{phieu_chi_id}}/huy",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "phieu-chi",
            "{{phieu_chi_id}}",
            "huy"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "PC PDF Preview",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/phieu-chi/{{phieu_chi_id}}/pdf-preview",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "phieu-chi",
            "{{phieu_chi_id}}",
            "pdf-preview"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Has base64\", () => pm.expect(pm.response.json().data.base64).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    }
  ]
}