{
  "name": "tmq-express-backend",
  "version": "1.0.0",
  "description": "TMQ Express ERP - Backend API (Fastify + Prisma + PostgreSQL)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:reset": "npx prisma migrate reset --force && npm run db:seed",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.3.2",
    "fastify-plugin": "^5.1.0",
    "pdfmake": "^0.2.18",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "eslint": "^9.22.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "vitest": "^4.1.8"
  }
}
