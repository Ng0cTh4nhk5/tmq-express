# TMQ Express Backend — Environment Variables
# Copy this file to .env and fill in your values

# Required: PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/tmq_express

# Required: JWT signing secret (≥16 characters, use a strong random string in production!)
JWT_SECRET=your-secret-key-here-change-me

# Optional (defaults shown)
JWT_EXPIRES_IN=8h
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# URL công khai của frontend (dùng cho QR code trong PDF)
# Nếu không set thì fallback về CORS_ORIGIN
APP_PUBLIC_URL=http://localhost:5173
