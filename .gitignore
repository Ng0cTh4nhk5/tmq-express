# Ignore everything in the root directory by default
/*

# Allow tracking these root files and folders
!/.gitignore
!/frontend/
!/backend/

# --- Frontend Ignores ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env
frontend/.env.*
frontend/.vite-cache*/
frontend/.vscode/

# --- Backend Ignores ---
backend/node_modules/
backend/dist/
backend/*.local
backend/.env
backend/.env.*
backend/prisma/dev.db
backend/prisma/dev.db-journal
backend/logs/
backend/*.log
